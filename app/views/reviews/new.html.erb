<div class="container mt-5">
  <h1>Write a review for <%= @restaurant.name %></h1>

  <%= simple_form_for [@restaurant, @review] do |f| %>
    <%= f.input :rating, collection: (0..5).to_a %>
    <%= f.input :content %>

    <%= f.submit "Create review", class: "btn btn-primary" %>
  <% end %>
</div>
